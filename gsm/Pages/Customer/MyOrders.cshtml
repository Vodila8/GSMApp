@page "/MyOrders"
@model gsm.Pages.MyOrdersModel
@{
    ViewData["Title"] = "My Orders";
}

<div class="user-form-page">
    <section class="warehouse-list my-orders">
        <h1 class="warehouse-title">My Orders</h1>
        @if (Model.Orders.Count == 0)
        {
            <p class="text-muted">You do not have any orders yet.</p>
        }
        else
        {
            <div class="order-cards">
                @foreach (var order in Model.Orders)
                {
                    <a class="order-card" href="/MyOrderDetails/@order.Id">
                        <span class="order-card-number">Order #@order.Id</span>
                        <span>@order.Device @if (!string.IsNullOrWhiteSpace(order.DeviceModelAndSerialNumber)) { <span>— @order.DeviceModelAndSerialNumber</span> }</span>
                        <span class="order-card-price">Total: @order.TotalPrice.ToString("0.00") EUR</span>
                        <span class="order-card-date">Created @order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                    </a>
                }
            </div>
        }
    </section>
</div>
