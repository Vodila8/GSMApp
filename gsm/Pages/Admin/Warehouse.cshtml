@page "/Warehouse"
@model gsm.Pages.WarehouseModel
@{
    ViewData["Title"] = "Warehouse";
}

<div class="user-form-page">
    <section class="warehouse-list warehouse-page">
        <div class="warehouse-page-heading">
            <h1 class="warehouse-title">Warehouse</h1>
            <div class="warehouse-page-actions">
                <a class="warehouse-action-button" href="/WarehouseReport" title="Warehouse report" aria-label="Warehouse report">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h10l4 4v14H5V3Zm9 1.8V8h3.2L14 4.8ZM8 12h8v-1.5H8V12Zm0 3h8v-1.5H8V15Zm0 3h5v-1.5H8V18Z" /></svg>
                </a>
                <button class="warehouse-action-button" type="button" data-open-warehouse-edit title="Edit warehouse" aria-label="Edit warehouse">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16.5V20h3.5L18.8 8.7l-3.5-3.5L4 16.5Zm16.7-10.9c.4-.4.4-1 0-1.4l-.9-.9a1 1 0 0 0-1.4 0l-1.7 1.7 3.5 3.5 1.7-1.7Z" /></svg>
                </button>
                <a class="warehouse-action-button" href="/WarehouseSales" title="Sales history" aria-label="Sales history">▤</a>
                <button class="warehouse-action-button warehouse-add-button" type="button" data-open-warehouse-item title="Add item" aria-label="Add item">+</button>
            </div>
        </div>
        <form method="get" class="warehouse-page-search" role="search">
            <label class="visually-hidden" for="warehouse-search">Search warehouse</label>
            <input id="warehouse-search" name="search" value="@Model.Search" placeholder="Search by barcode or part name" />
            <button class="btn btn-primary" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a class="btn btn-outline-secondary" href="/Warehouse">Clear</a>
            }
        </form>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <datalist id="warehouse-product-numbers">
            @foreach (var productNumber in Model.ProductNumbers)
            {
                <option value="@productNumber"></option>
            }
        </datalist>

        <div class="table-responsive">
            <table class="table warehouse-table warehouse-items-table align-middle">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Product number</th>
                        <th>Quantity</th>
                        <th>Part name</th>
                        <th>Partner</th>
                        <th>Barcode</th>
                        <th>Unit price (EUR)</th>
                        <th>Delivery price (EUR)</th>
                        <th>Photos</th>
                    </tr>
                </thead>
                <tbody>
                @for (var index = 0; index < Model.Items.Count; index++)
                {
                    <tr>
                        <td>@(index + 1)</td>
                        <td>@(Model.Items[index].ProductNumber ?? "—")</td>
                        <td>@Model.Items[index].Quantity</td>
                        <td>@Model.Items[index].PartName</td>
                        <td>@(Model.Items[index].PartnerName ?? "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(Model.Items[index].Barcode) ? "—" : Model.Items[index].Barcode)</td>
                        <td>@Model.Items[index].UnitPrice.ToString("0.00")</td>
                        <td>@Model.Items[index].DeliveryPrice.ToString("0.00")</td>
                        <td>
                            <div class="warehouse-photo-list">
                                @foreach (var photo in Model.Items[index].Photos)
                                {
                                    <div class="warehouse-photo-item"><a href="/uploads/warehouse/@photo.FileName" target="_blank"><img src="/uploads/warehouse/@photo.FileName" alt="@(photo.OriginalFileName ?? "Warehouse photo")" /></a></div>
                                }
                                @if (Model.Items[index].Photos.Count == 0)
                                {
                                    <span>—</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

<dialog id="warehouse-edit-dialog" class="warehouse-edit-dialog">
    <form method="post" asp-page-handler="Save" enctype="multipart/form-data" class="warehouse-edit-form">
        <div class="create-user-modal-header">
            <h2>Edit warehouse</h2>
            <button type="button" class="create-user-close" data-close-warehouse-edit aria-label="Close">×</button>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="table-responsive">
            <table class="table warehouse-table warehouse-edit-table align-middle">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Product number</th>
                        <th>Quantity</th>
                        <th>Part name</th>
                        <th>Barcode</th>
                        <th>Unit price</th>
                        <th>Delivery price</th>
                        <th>Photos</th>
                    </tr>
                </thead>
                <tbody>
                @for (var index = 0; index < Model.Items.Count; index++)
                {
                    <tr>
                        <td>@(index + 1)<input asp-for="Items[index].Id" type="hidden" /></td>
                        <td><input asp-for="Items[index].ProductNumber" list="warehouse-product-numbers" /></td>
                        <td><input asp-for="Items[index].Quantity" type="number" min="0" step="1" /></td>
                        <td><input asp-for="Items[index].PartName" /></td>
                        <td><input asp-for="Items[index].Barcode" /></td>
                        <td><input asp-for="Items[index].UnitPrice" type="number" min="0" step="0.01" /></td>
                        <td><input asp-for="Items[index].DeliveryPrice" type="number" min="0" step="0.01" /></td>
                        <td>
                            <div class="warehouse-photo-picker" data-photo-picker>
                                <label class="warehouse-photo-add">Choose photos<input asp-for="Items[index].NewPhotos" class="warehouse-photo-input" type="file" accept="image/jpeg,image/png,image/gif,image/webp" multiple /></label>
                                <div class="warehouse-photo-list warehouse-edit-photo-list" data-photo-preview>
                                @foreach (var photo in Model.Items[index].Photos)
                                {
                                    <div class="warehouse-photo-item" data-existing-photo-id="@photo.Id"><a href="/uploads/warehouse/@photo.FileName" target="_blank"><img src="/uploads/warehouse/@photo.FileName" alt="@(photo.OriginalFileName ?? "Warehouse photo")" /></a><button type="button" class="warehouse-photo-delete" data-remove-existing-photo="@photo.Id" title="Remove photo" aria-label="Remove photo">×</button></div>
                                }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="create-user-modal-actions">
            <button type="button" class="btn btn-outline-secondary" data-close-warehouse-edit>Cancel</button>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</dialog>

<dialog id="warehouse-item-dialog" class="create-user-dialog">
    <form method="post" asp-page-handler="Save" enctype="multipart/form-data" class="create-user-modal-form">
        <div class="create-user-modal-header">
            <h2>Add warehouse item</h2>
            <button type="button" class="create-user-close" data-close-warehouse-item aria-label="Close">×</button>
        </div>
        <div class="text-muted mb-3">A product number is generated automatically, but you can choose an existing number or enter a new one.</div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="user-form-row"><label asp-for="NewItem.ProductNumber">Product number</label><input asp-for="NewItem.ProductNumber" list="warehouse-product-numbers" /></div>
        <div class="user-form-row">
            <label for="new-item-partner-select">Partner</label>
            <select id="new-item-partner-select">
                @if (Model.Partners.Count > 0)
                {
                    <option value="" disabled selected>Choose partner</option>
                }
                @if (Model.Partners.Count == 0)
                {
                    <option value="__new__" selected>Add new partner</option>
                }
                else
                {
                    <option value="__new__">Add new partner</option>
                }
                @foreach (var partner in Model.Partners)
                {
                    <option value="@partner.Id">@partner.Name</option>
                }
            </select>
            <input asp-for="NewItem.PartnerId" type="hidden" id="new-item-partner-id" />
        </div>
        <div class="user-form-row" id="new-item-partner-name-field" hidden>
            <label asp-for="NewItem.NewPartnerName">New partner name</label>
            <input asp-for="NewItem.NewPartnerName" placeholder="Partner name" />
        </div>
        <div class="user-form-row"><label asp-for="NewItem.PartName">Part name</label><input asp-for="NewItem.PartName" required /></div>
        <div class="user-form-row">
            <label asp-for="NewItem.Photos">Photos</label>
            <div class="warehouse-photo-picker" data-photo-picker>
                <label class="warehouse-photo-add">Choose photos
                    <input asp-for="NewItem.Photos" class="warehouse-photo-input" type="file" accept="image/jpeg,image/png,image/gif,image/webp" multiple />
                </label>
                <div class="warehouse-photo-list warehouse-edit-photo-list" data-photo-preview></div>
            </div>
            <small class="text-muted">You can select multiple photos. Maximum 10 files, 10 MB each.</small>
        </div>
        <div class="user-form-row user-form-row-two-columns">
            <div><label asp-for="NewItem.Quantity">Quantity</label><input asp-for="NewItem.Quantity" type="number" min="0" step="1" /></div>
            <div><label asp-for="NewItem.Barcode">Barcode</label><input asp-for="NewItem.Barcode" /></div>
        </div>
        <div class="user-form-row user-form-row-two-columns">
            <div><label asp-for="NewItem.UnitPrice">Unit price (EUR)</label><input asp-for="NewItem.UnitPrice" type="number" min="0" step="0.01" /></div>
            <div><label asp-for="NewItem.DeliveryPrice">Delivery price (EUR)</label><input asp-for="NewItem.DeliveryPrice" type="number" min="0" step="0.01" /></div>
        </div>
        <div class="create-user-modal-actions">
            <button type="button" class="btn btn-outline-secondary" data-close-warehouse-item>Cancel</button>
            <button type="submit" class="btn btn-primary">Add item</button>
        </div>
    </form>
</dialog>

<dialog id="warehouse-delivery-dialog" class="warehouse-edit-dialog warehouse-delivery-dialog">
    <form method="post" asp-page-handler="SaveDelivery" enctype="multipart/form-data" class="warehouse-edit-form">
        <div class="create-user-modal-header">
            <h2>Warehouse delivery</h2>
            <button type="button" class="create-user-close" data-close-warehouse-delivery aria-label="Close">×</button>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="table-responsive">
            <table class="table warehouse-table warehouse-edit-table warehouse-delivery-table align-middle">
                <thead><tr><th>No.</th><th>Delivery date</th><th>Product number</th><th>Quantity</th><th>Part name</th><th>Partner</th><th>Barcode</th><th>Unit price</th><th>Delivery price</th><th>Photos</th><th></th></tr></thead>
                <tbody id="delivery-items-body">
                @for (var index = 0; index < Model.DeliveryItems.Count; index++)
                {
                    <tr class="delivery-item-row" data-delivery-row>
                        <td>@(index + 1)</td>
                        <td><input asp-for="DeliveryItems[index].DeliveryDate" type="date" /></td>
                        <td><input asp-for="DeliveryItems[index].ProductNumber" list="warehouse-product-numbers" /></td>
                        <td><input asp-for="DeliveryItems[index].Quantity" type="number" min="0" step="1" /></td>
                        <td><input asp-for="DeliveryItems[index].PartName" required /></td>
                        <td>
                            <select asp-for="DeliveryItems[index].PartnerId" class="delivery-partner-select">
                                <option value="">Add new partner</option>
                                @foreach (var partner in Model.Partners)
                                {
                                    <option value="@partner.Id">@partner.Name</option>
                                }
                            </select>
                            <input asp-for="DeliveryItems[index].NewPartnerName" class="delivery-new-partner" placeholder="New partner name" />
                        </td>
                        <td><input asp-for="DeliveryItems[index].Barcode" /></td>
                        <td><input asp-for="DeliveryItems[index].UnitPrice" type="number" min="0" step="0.01" /></td>
                        <td><input asp-for="DeliveryItems[index].DeliveryPrice" type="number" min="0" step="0.01" /></td>
                        <td><div class="warehouse-photo-picker" data-photo-picker><label class="warehouse-photo-add">Choose photos<input asp-for="DeliveryItems[index].Photos" class="warehouse-photo-input" type="file" accept="image/jpeg,image/png,image/gif,image/webp" multiple /></label><div class="warehouse-photo-list warehouse-edit-photo-list" data-photo-preview></div></div></td>
                        <td><button type="button" class="btn btn-link text-danger remove-delivery-row">×</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <template id="delivery-row-template">
            <tr class="delivery-item-row" data-delivery-row>
                <td>__number__</td>
                <td><input name="DeliveryItems[__index__].DeliveryDate" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" /></td>
                <td><input name="DeliveryItems[__index__].ProductNumber" list="warehouse-product-numbers" /></td>
                <td><input name="DeliveryItems[__index__].Quantity" type="number" min="0" step="1" /></td>
                <td><input name="DeliveryItems[__index__].PartName" required /></td>
                <td><select name="DeliveryItems[__index__].PartnerId" class="delivery-partner-select"><option value="">Add new partner</option>@foreach (var partner in Model.Partners) { <option value="@partner.Id">@partner.Name</option> }</select><input name="DeliveryItems[__index__].NewPartnerName" class="delivery-new-partner" placeholder="New partner name" /></td>
                <td><input name="DeliveryItems[__index__].Barcode" /></td>
                <td><input name="DeliveryItems[__index__].UnitPrice" type="number" min="0" step="0.01" /></td>
                <td><input name="DeliveryItems[__index__].DeliveryPrice" type="number" min="0" step="0.01" /></td>
                <td><button type="button" class="btn btn-link text-danger remove-delivery-row">×</button></td>
            </tr>
        </template>
        <button type="button" id="add-delivery-row" class="btn btn-outline-secondary btn-sm">+ Add item</button>
        <div class="create-user-modal-actions"><button type="button" class="btn btn-outline-secondary" data-close-warehouse-delivery>Cancel</button><button type="submit" class="btn btn-primary">Save delivery</button></div>
    </form>
</dialog>

<dialog id="warehouse-sale-dialog" class="create-user-dialog warehouse-sale-dialog">
    <form method="post" asp-page-handler="Sell" class="create-user-modal-form">
        <div class="create-user-modal-header">
            <h2>Sell warehouse item</h2>
            <button type="button" class="create-user-close" data-close-warehouse-sale aria-label="Close">×</button>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="user-form-row">
            <label for="sale-product-search">Search product</label>
            <input id="sale-product-search" type="search" placeholder="Search by barcode or part name" autocomplete="off" />
        </div>
        <div class="user-form-row">
            <label asp-for="Sale.WarehouseItemId">Product</label>
            <select asp-for="Sale.WarehouseItemId" id="sale-product-select" size="6">
                <option value="">Select product</option>
                @foreach (var item in Model.Items)
                {
                    <option value="@item.Id" data-unit-price="@item.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-search="@($"{item.PartName} {item.ProductNumber} {item.Barcode}")">@item.PartName · product @item.ProductNumber · barcode @(string.IsNullOrWhiteSpace(item.Barcode) ? "—" : item.Barcode) · stock: @item.Quantity</option>
                }
            </select>
        </div>
        <div class="user-form-row">
            <label for="sale-partner-select">Partner</label>
            <select id="sale-partner-select">
                @if (Model.Partners.Count > 0)
                {
                    <option value="" disabled selected>Choose partner</option>
                }
                @if (Model.Partners.Count == 0)
                {
                    <option value="__new__" selected>Add new partner</option>
                }
                else
                {
                    <option value="__new__">Add new partner</option>
                }
                @foreach (var partner in Model.Partners)
                {
                    <option value="@partner.Id">@partner.Name</option>
                }
            </select>
            <input asp-for="Sale.PartnerId" type="hidden" id="sale-partner-id" />
        </div>
        <div class="user-form-row" id="sale-partner-name-field" hidden>
            <label asp-for="Sale.NewPartnerName">New partner name</label>
            <input asp-for="Sale.NewPartnerName" placeholder="Partner name" />
        </div>
        <div class="user-form-row user-form-row-two-columns">
            <div><label asp-for="Sale.SaleDate">Sale date</label><input asp-for="Sale.SaleDate" type="date" /></div>
            <div><label asp-for="Sale.Quantity">Quantity</label><input asp-for="Sale.Quantity" id="sale-quantity" type="number" min="1" /></div>
        </div>
        <div class="user-form-row user-form-row-two-columns">
            <div><label asp-for="Sale.DiscountPercent">Discount (%)</label><input asp-for="Sale.DiscountPercent" id="sale-discount" type="number" min="0" max="100" step="0.01" /></div>
        </div>
        <div class="user-form-row user-form-row-two-columns">
            <div><label for="sale-total">Total amount</label><input id="sale-total" type="text" value="0.00 EUR" readonly /></div>
            <div><label asp-for="Sale.Note">Note</label><input asp-for="Sale.Note" placeholder="Optional note" /></div>
        </div>
        <div class="create-user-modal-actions">
            <button type="button" class="btn btn-outline-secondary" data-close-warehouse-sale>Cancel</button>
            <button type="submit" class="btn btn-primary">Record sale</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const warehouseEditDialog = document.getElementById('warehouse-edit-dialog');
        const warehouseItemDialog = document.getElementById('warehouse-item-dialog');
        const warehouseSaleDialog = document.getElementById('warehouse-sale-dialog');
        const warehouseDeliveryDialog = document.getElementById('warehouse-delivery-dialog');

        function setupPartnerChoice(selectId, partnerIdId, newNameId, newNameFieldId) {
            const select = document.getElementById(selectId);
            const partnerId = document.getElementById(partnerIdId);
            const newName = document.getElementById(newNameId);
            const newNameField = document.getElementById(newNameFieldId);
            const useNewPartner = () => {
                const isNew = select.value === '__new__';
                newNameField.hidden = !isNew;
                if (isNew) {
                    partnerId.value = '';
                    newName.focus();
                } else {
                    partnerId.value = select.value;
                    newName.value = '';
                }
            };
            if (newName.value.trim()) select.value = '__new__';
            else if (partnerId.value) select.value = partnerId.value;
            useNewPartner();
            select.addEventListener('change', useNewPartner);
        }

        function setupPhotoPicker(picker) {
            const input = picker.querySelector('.warehouse-photo-input');
            const preview = picker.querySelector('[data-photo-preview]');
            let files = [];

            const syncFiles = () => {
                const dataTransfer = new DataTransfer();
                files.forEach(file => dataTransfer.items.add(file));
                input.files = dataTransfer.files;
            };

            const renderFiles = () => {
                picker.querySelectorAll('[data-new-photo]').forEach(photo => photo.remove());
                files.forEach((file, index) => {
                    const item = document.createElement('div');
                    item.className = 'warehouse-photo-item';
                    item.dataset.newPhoto = '';
                    item.innerHTML = `<img src="${URL.createObjectURL(file)}" alt="${file.name}"><button type="button" class="warehouse-photo-delete" data-remove-new-photo="${index}" title="Remove photo" aria-label="Remove photo">×</button>`;
                    preview.appendChild(item);
                });
            };

            input.addEventListener('change', () => {
                files = Array.from(input.files);
                renderFiles();
            });
            picker.addEventListener('click', event => {
                const removeButton = event.target.closest('[data-remove-new-photo]');
                if (removeButton) {
                    files.splice(Number(removeButton.dataset.removeNewPhoto), 1);
                    syncFiles();
                    renderFiles();
                    return;
                }

                const existingButton = event.target.closest('[data-remove-existing-photo]');
                if (existingButton) {
                    const deletedInput = document.createElement('input');
                    deletedInput.type = 'hidden';
                    deletedInput.name = input.name.replace('.NewPhotos', '.DeletedPhotoIds');
                    deletedInput.value = existingButton.dataset.removeExistingPhoto;
                    picker.appendChild(deletedInput);
                    existingButton.closest('[data-existing-photo-id]').remove();
                }
            });
        }

        const saleProduct = document.getElementById('sale-product-select');
        const saleQuantity = document.getElementById('sale-quantity');
        const saleDiscount = document.getElementById('sale-discount');
        const saleTotal = document.getElementById('sale-total');
        function updateSaleTotal() {
            const option = saleProduct.options[saleProduct.selectedIndex];
            const unitPrice = Number(option?.dataset.unitPrice || 0);
            const quantity = Number(saleQuantity.value || 0);
            const discount = Number(saleDiscount.value || 0);
            saleTotal.value = `${(unitPrice * quantity * (1 - discount / 100)).toFixed(2)} EUR`;
        }
        const saleProductSearch = document.getElementById('sale-product-search');
        saleProductSearch.addEventListener('input', () => {
            const term = saleProductSearch.value.trim().toLowerCase();
            [...saleProduct.options].forEach((option, index) => {
                if (index === 0) return;
                option.hidden = term !== '' && !(option.dataset.search || option.textContent).toLowerCase().includes(term);
            });
            if (saleProduct.selectedOptions[0]?.hidden) saleProduct.value = '';
            updateSaleTotal();
        });
        saleProduct.addEventListener('change', updateSaleTotal);
        saleQuantity.addEventListener('input', updateSaleTotal);
        saleDiscount.addEventListener('input', updateSaleTotal);
        updateSaleTotal();
        const deliveryCatalog = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(item => new { item.ProductNumber, item.PartName }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        function setupDeliveryProductRow(row) {
            const productNumber = row.querySelector('input[name$=".ProductNumber"]');
            const partName = row.querySelector('input[name$=".PartName"]');
            productNumber.addEventListener('input', () => {
                const value = productNumber.value.trim().toLowerCase().replace(/^p-/, '');
                const item = deliveryCatalog.find(product => String(product.productNumber || '').trim().toLowerCase().replace(/^p-/, '') === value);
                if (item) partName.value = item.partName;
            });
        }
        function setupDeliveryPartner(row) {
            const select = row.querySelector('.delivery-partner-select');
            const newPartner = row.querySelector('.delivery-new-partner');
            const update = () => {
                const isNew = !select.value;
                newPartner.hidden = !isNew;
                if (!isNew) newPartner.value = '';
            };
            update();
            select.addEventListener('change', update);
        }

        document.querySelectorAll('[data-photo-picker]').forEach(setupPhotoPicker);
        document.querySelectorAll('[data-delivery-row]').forEach(row => { setupDeliveryProductRow(row); setupDeliveryPartner(row); });
        const deliveryItemsBody = document.getElementById('delivery-items-body');
        let deliveryIndex = deliveryItemsBody.querySelectorAll('[data-delivery-row]').length;
        document.getElementById('add-delivery-row').addEventListener('click', () => {
            const rowMarkup = document.getElementById('delivery-row-template').innerHTML
                .replaceAll('__index__', deliveryIndex)
                .replaceAll('__number__', deliveryIndex + 1);
            deliveryItemsBody.insertAdjacentHTML('beforeend', rowMarkup);
            const row = deliveryItemsBody.lastElementChild;
            setupPhotoPicker(row.querySelector('[data-photo-picker]'));
            setupDeliveryProductRow(row);
            setupDeliveryPartner(row);
            deliveryIndex++;
        });
        deliveryItemsBody.addEventListener('click', event => {
            if (event.target.closest('.remove-delivery-row') && deliveryItemsBody.querySelectorAll('[data-delivery-row]').length > 1) {
                event.target.closest('[data-delivery-row]').remove();
            }
        });
        warehouseDeliveryDialog.querySelector('form').addEventListener('submit', () => {
            deliveryItemsBody.querySelectorAll('[data-delivery-row]').forEach((row, index) => {
                row.querySelectorAll('input[name], select[name]').forEach(input => {
                    input.name = input.name.replace(/DeliveryItems\[\d+\]/, `DeliveryItems[${index}]`);
                });
            });
        });
        setupPartnerChoice('new-item-partner-select', 'new-item-partner-id', 'NewItem_NewPartnerName', 'new-item-partner-name-field');
        setupPartnerChoice('sale-partner-select', 'sale-partner-id', 'Sale_NewPartnerName', 'sale-partner-name-field');
        document.querySelector('[data-open-warehouse-edit]').addEventListener('click', () => warehouseEditDialog.showModal());
        document.querySelector('[data-open-warehouse-item]').addEventListener('click', () => warehouseItemDialog.showModal());
        document.querySelector('[data-open-warehouse-sale]')?.addEventListener('click', () => warehouseSaleDialog.showModal());
        document.querySelectorAll('[data-close-warehouse-edit]').forEach(button => button.addEventListener('click', () => warehouseEditDialog.close()));
        document.querySelectorAll('[data-close-warehouse-item]').forEach(button => button.addEventListener('click', () => warehouseItemDialog.close()));
        document.querySelectorAll('[data-close-warehouse-sale]').forEach(button => button.addEventListener('click', () => warehouseSaleDialog.close()));
        document.querySelectorAll('[data-close-warehouse-delivery]').forEach(button => button.addEventListener('click', () => warehouseDeliveryDialog.close()));
        @if (Model.ShowDeliveryModal)
        {
            <text>warehouseDeliveryDialog.showModal();</text>
        }
        @if (Model.ShowSaleModal)
        {
            <text>warehouseSaleDialog.showModal();</text>
        }
        @if (Model.ShowEditModal)
        {
            <text>warehouseEditDialog.showModal();</text>
        }
        @if (Model.ShowAddModal)
        {
            <text>warehouseItemDialog.showModal();</text>
        }
    </script>
}
