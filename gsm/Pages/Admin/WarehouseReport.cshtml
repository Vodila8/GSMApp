@page "/WarehouseReport"
@model gsm.Pages.WarehouseReportModel
@{
    ViewData["Title"] = "Warehouse Help";
}

<div class="user-form-page">
    <section class="warehouse-list warehouse-report-page">
        <div class="dashboard-heading">
            <div>
                <span class="dashboard-kicker">INVENTORY</span>
                <h1 class="warehouse-title">Warehouse Help</h1>
            </div>
            <a class="back-link" href="/Warehouse">← Back to warehouse</a>
        </div>

        <form method="get" class="warehouse-report-filters">
            <div><label for="report-type">Report</label><select id="report-type" name="Type">@if (Model.IsDeliveryReport) { <option value="sales">Sales</option><option value="deliveries" selected>Deliveries</option> } else { <option value="sales" selected>Sales</option><option value="deliveries">Deliveries</option> }</select></div>
            <div><label for="report-from">From date</label><input id="report-from" name="FromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" /></div>
            <div><label for="report-to">To date</label><input id="report-to" name="ToDate" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")" /></div>
            <div><label for="report-product">Product number</label><input id="report-product" name="ProductNumber" value="@Model.ProductNumber" placeholder="Product number" /></div>
            <button class="btn btn-primary" type="submit">Filter</button>
            <a class="btn btn-outline-secondary" href="/WarehouseReport">Clear</a>
        </form>

        @if (Model.IsDeliveryReport)
        {
            if (Model.Deliveries.Count == 0)
            {
                <p class="text-muted">No deliveries match the selected filters.</p>
            }
            else
            {
                <div class="table-responsive"><table class="table warehouse-table warehouse-report-table"><thead><tr><th>Date</th><th>Product number</th><th>Part name</th><th>Partner</th><th>Quantity</th><th>Barcode</th><th>Unit price</th><th>Delivery price</th></tr></thead><tbody>
                @foreach (var item in Model.Deliveries)
                {
                    <tr><td>@item.DeliveryDate?.ToString("dd.MM.yyyy")</td><td>@(item.ProductNumber ?? item.Id.ToString())</td><td>@item.PartName</td><td>@(item.Partner?.Name ?? "—")</td><td>@item.Quantity</td><td>@(item.Barcode ?? "—")</td><td>@item.UnitPrice.ToString("0.00") EUR</td><td>@item.DeliveryPrice.ToString("0.00") EUR</td></tr>
                }
                </tbody></table></div>
            }
        }
        else if (Model.Sales.Count == 0)
        {
            <p class="text-muted">No sales match the selected filters.</p>
        }
        else
        {
            <div class="table-responsive"><table class="table warehouse-table warehouse-report-table"><thead><tr><th>Date</th><th>Partner</th><th>Product number</th><th>Product</th><th>Quantity</th><th>Unit price</th><th>Discount</th><th>Total amount</th><th>Note</th><th>User</th></tr></thead><tbody>
            @foreach (var sale in Model.Sales)
            {
                <tr><td>@(sale.SaleDate?.ToString("dd.MM.yyyy") ?? sale.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy"))</td><td>@sale.Partner.Name</td><td>@(sale.WarehouseItem.ProductNumber ?? sale.WarehouseItem.Id.ToString())</td><td>@sale.WarehouseItem.PartName</td><td>@sale.Quantity</td><td>@sale.UnitPrice.ToString("0.00") EUR</td><td>@sale.DiscountPercent.ToString("0.##")%</td><td>@sale.TotalAmount.ToString("0.00") EUR</td><td>@(sale.Note ?? "—")</td><td>@sale.UserEmail</td></tr>
            }
            </tbody></table></div>
        }
    </section>
</div>
