@page "/CreateUser"
@model gsm.Pages.CreateUserModel
@{
    ViewData["Title"] = "Create User";
}

<div class="user-form-page">
    <form class="user-form" method="post">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="alert alert-success" role="alert">@statusMessage</div>
        }

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="user-form-row user-form-row-two-columns">
            <div>
                <label asp-for="Input.CustomerName"></label>
                <input asp-for="Input.CustomerName" />
            </div>
            <div>
                <label asp-for="Input.PhoneNumber"></label>
                <input asp-for="Input.PhoneNumber" type="tel" />
            </div>
        </div>

        <div class="user-form-row">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" type="email" />
        </div>

        <div class="user-form-row">
            <label asp-for="Input.Role"></label>
            <select asp-for="Input.Role">
                <option value="User">User</option>
                <option value="Technician">Technician</option>
                @if (User.IsInRole("Boss"))
                {
                    <option value="Administrator">Administrator</option>
                }
            </select>
        </div>

        <button class="btn btn-primary" type="submit">Create User</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
