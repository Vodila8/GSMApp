@page "/WarehouseSales"
@model gsm.Pages.WarehouseSalesModel
@{
    ViewData["Title"] = "Sales history";
}

<div class="user-form-page">
    <section class="warehouse-list warehouse-report-page">
        <div class="dashboard-heading">
            <div>
                <span class="dashboard-kicker">INVENTORY</span>
                <h1 class="warehouse-title">Sales history</h1>
            </div>
            <a class="back-link" href="/Warehouse">← Back to warehouse</a>
        </div>

        @if (Model.Sales.Count == 0)
        {
            <p class="text-muted">No sales have been recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table warehouse-table warehouse-report-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Partner</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit price</th>
                            <th>Discount</th>
                            <th>Total amount</th>
                            <th>Note</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var sale in Model.Sales)
                    {
                        <tr>
                            <td>@sale.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@sale.Partner.Name</td>
                            <td>@sale.WarehouseItem.PartName</td>
                            <td>@sale.Quantity</td>
                            <td>@sale.UnitPrice.ToString("0.00") EUR</td>
                            <td>@sale.DiscountPercent.ToString("0.##")%</td>
                            <td>@sale.TotalAmount.ToString("0.00") EUR</td>
                            <td>@(string.IsNullOrWhiteSpace(sale.Note) ? "—" : sale.Note)</td>
                            <td>@sale.UserEmail</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
