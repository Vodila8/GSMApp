@page "/AdminOrder/{id:int}"
@model gsm.Pages.AdminOrderModel
@{
    ViewData["Title"] = "Manage Order";
}

<div class="user-form-page">
    <section class="warehouse-list order-form repair-form admin-order-page">
        <h1 class="warehouse-title">Order #@Model.Order.Id</h1>
        <p><strong>@(Model.Order.Customer == null ? "No customer" : Model.Order.Customer.CustomerName ?? Model.Order.Customer.Email)</strong><br />@Model.Order.Device — @Model.Order.DeviceModelAndSerialNumber</p>
        <a class="btn btn-outline-primary btn-sm" href="/OrderTracking/@Model.Order.Id">Manage stages and dates</a>

        <form method="post" asp-page-handler="ScanAdb" class="mt-3">
            <button class="btn btn-outline-success" type="submit">Scan Phone with ADB</button>
            <small class="d-block text-muted mt-1">Connect and unlock the Android phone, then allow USB debugging.</small>
        </form>
        @if (TempData["AdbStatus"] is string adbStatus)
        {
            <div class="alert alert-success mt-3" role="alert">@adbStatus</div>
        }
        @if (TempData["AdbError"] is string adbError)
        {
            <div class="alert alert-danger mt-3" role="alert">@adbError</div>
        }
        @if (Model.AdbReport is not null)
        {
            <section class="adb-report mt-3" role="status">
                <div class="adb-report-header">
                    <div>
                        <span class="adb-report-kicker">DEVICE CHECK</span>
                        <h3>Phone diagnostic report</h3>
                    </div>
                    <span class="adb-report-status">Connected</span>
                </div>
                <div class="adb-report-grid">
                    <div class="adb-report-item"><span>Manufacturer</span><strong>@Model.AdbReport.Manufacturer</strong></div>
                    <div class="adb-report-item"><span>Model</span><strong>@Model.AdbReport.Model</strong></div>
                    <div class="adb-report-item"><span>Android version</span><strong>@Model.AdbReport.AndroidVersion</strong></div>
                    <div class="adb-report-item"><span>Serial number</span><strong>@Model.AdbReport.SerialNumber</strong></div>
                    <div class="adb-report-item"><span>Battery level</span><strong>@Model.AdbReport.BatteryLevel%</strong></div>
                    <div class="adb-report-item"><span>Battery health</span><strong>@Model.AdbReport.BatteryHealth</strong></div>
                    <div class="adb-report-item"><span>Battery temperature</span><strong>@Model.AdbReport.BatteryTemperature</strong></div>
                </div>
                <div class="adb-report-storage">
                    <span>Internal storage</span>
                    <strong>@Model.AdbReport.Storage</strong>
                </div>
            </section>
        }

        <form method="post" asp-page-handler="SaveOrder" enctype="multipart/form-data" id="edit-order-form">
            @if (TempData["StatusMessage"] is string statusMessage) { <div class="alert alert-success mt-3">@statusMessage</div> }
            <div asp-validation-summary="All" class="text-danger"></div>
            <section class="repair-section">
                <h2 class="repair-section-title"><span>1</span> Customer and device</h2>
                <div class="user-form-row user-form-row-two-columns">
                    <div><label asp-for="Input.CustomerId">Customer</label><select asp-for="Input.CustomerId" id="edit-customer-select"><option value="">Select customer</option>@foreach (var customer in Model.Customers) { <option value="@customer.Id">@(customer.CustomerName ?? customer.Email) — @customer.Email</option> }</select></div>
                    <div><label asp-for="Input.CustomerDeviceId">Device</label><select asp-for="Input.CustomerDeviceId" id="edit-device-select"></select></div>
                </div>
                <div id="edit-new-device-fields" class="user-form-row user-form-row-two-columns">
                    <div><label asp-for="Input.NewDeviceType">New Device</label><select asp-for="Input.NewDeviceType"><option value="">Select device type</option><option>Computer</option><option>Laptop</option><option>Printer</option><option>Phone</option><option>Tablet</option><option>Other</option></select></div>
                    <div><label asp-for="Input.NewDeviceModelAndSerialNumber">Model and Serial Number (SN)</label><input asp-for="Input.NewDeviceModelAndSerialNumber" /></div>
                </div>
                <div class="user-form-row"><label for="edit-device-photos">Device photos</label><div class="warehouse-photo-picker" id="edit-device-photo-picker"><label class="warehouse-photo-add">Choose photos<input id="edit-device-photos" name="Input.DevicePhotos" class="warehouse-photo-input" type="file" accept="image/jpeg,image/png,image/gif,image/webp" multiple /></label><div class="warehouse-photo-list warehouse-edit-photo-list" id="edit-device-photo-preview"></div></div></div>
            </section>
            <section class="repair-section">
                <h2 class="repair-section-title"><span>2</span> Device acceptance</h2>
                <div class="user-form-row"><label asp-for="Input.ProblemOrRepair">Problem / Repair</label><textarea asp-for="Input.ProblemOrRepair" rows="3"></textarea></div>
                <div class="user-form-row"><label asp-for="Input.DeviceConditionAndNotes">Device Condition and Notes at Acceptance</label><textarea asp-for="Input.DeviceConditionAndNotes" rows="3"></textarea></div>
                <div class="user-form-row user-form-row-two-columns"><div><label asp-for="Input.Accessories">Accessories</label><input asp-for="Input.Accessories" type="hidden" id="edit-accessories-value" /><div class="accessory-options" id="edit-accessories-options"><button type="button" class="accessory-option" data-accessory="SIM card">SIM card</button><button type="button" class="accessory-option" data-accessory="Case">Case</button><button type="button" class="accessory-option" data-accessory="Charger">Charger</button><button type="button" class="accessory-option" data-accessory="Cable">Cable</button><button type="button" class="accessory-option" data-accessory="Bag">Bag</button><button type="button" class="accessory-option" data-accessory="Other">Other</button></div><input asp-for="Input.OtherAccessory" id="edit-accessories-other" class="accessory-other-input" type="text" placeholder="Write accessory" hidden /></div><div><label asp-for="Input.DevicePassword">Device Password</label><input asp-for="Input.DevicePassword" type="text" /></div></div>
                <input asp-for="Input.AdbDiagnosticReport" type="hidden" />
            </section>
            <h2 class="order-section-title">Parts from Warehouse</h2>
            <div class="table-responsive"><table class="table warehouse-table"><thead><tr><th>Part</th><th>Unit Price (EUR)</th><th>Quantity</th><th></th></tr></thead><tbody id="parts-body">
            @for (var index = 0; index < Model.Parts.Count; index++)
            {
                <tr class="part-row"><td><input asp-for="Parts[index].OrderLineId" type="hidden" /><select asp-for="Parts[index].WarehouseItemId" class="part-select"><option value="">Select part</option>@foreach (var part in Model.WarehouseItems) { <option value="@part.Id" data-price="@part.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">@part.PartName (in stock: @part.Quantity)</option> }</select></td><td><input asp-for="Parts[index].UnitPrice" class="line-price" type="number" min="0" step="0.01" /></td><td><input asp-for="Parts[index].Quantity" class="line-quantity" type="number" min="1" step="1" /></td><td><button class="btn btn-link text-danger remove-part" type="button">×</button></td></tr>
            }
            </tbody></table></div>
            <button id="add-part" class="btn btn-outline-secondary btn-sm" type="button">+ Add Part</button>

            <h2 class="order-section-title">Services</h2>
            <div class="table-responsive"><table class="table warehouse-table"><thead><tr><th>Service</th><th>Price (EUR)</th><th></th></tr></thead><tbody id="services-body">
            @for (var index = 0; index < Model.Services.Count; index++)
            {
                <tr class="service-row"><td><input asp-for="Services[index].OrderLineId" type="hidden" /><input asp-for="Services[index].Description" placeholder="e.g. Diagnostics" /></td><td><input asp-for="Services[index].UnitPrice" class="service-price" type="number" min="0" step="0.01" /></td><td><button class="btn btn-link text-danger remove-service" type="button">×</button></td></tr>
            }
            </tbody></table></div>
            <button id="add-service" class="btn btn-outline-secondary btn-sm" type="button">+ Add Service</button>
            <div class="order-total">Total: <strong id="edit-order-total">0.00 EUR</strong></div>
            <button class="btn btn-primary" type="submit">Save Order Changes</button>
        </form>
    </section>
</div>

<template id="part-template"><tr class="part-row"><td><input name="Parts[__index__].OrderLineId" type="hidden" value="0" /><select name="Parts[__index__].WarehouseItemId" class="part-select"><option value="">Select part</option>@foreach (var part in Model.WarehouseItems) { <option value="@part.Id" data-price="@part.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">@part.PartName (in stock: @part.Quantity)</option> }</select></td><td><input name="Parts[__index__].UnitPrice" class="line-price" type="number" min="0" step="0.01" /></td><td><input name="Parts[__index__].Quantity" class="line-quantity" type="number" min="1" value="1" step="1" /></td><td><button class="btn btn-link text-danger remove-part" type="button">×</button></td></tr></template>
<template id="service-template"><tr class="service-row"><td><input name="Services[__index__].OrderLineId" type="hidden" value="0" /><input name="Services[__index__].Description" placeholder="e.g. Diagnostics" /></td><td><input name="Services[__index__].UnitPrice" class="service-price" type="number" min="0" step="0.01" /></td><td><button class="btn btn-link text-danger remove-service" type="button">×</button></td></tr></template>

@section Scripts {
<script>
let partIndex = @Model.Parts.Count, serviceIndex = @Model.Services.Count;
const partsBody = document.getElementById('parts-body'), servicesBody = document.getElementById('services-body');
function total() { let value = 0; document.querySelectorAll('.part-row').forEach(r => value += (parseFloat(r.querySelector('.line-price').value) || 0) * (parseInt(r.querySelector('.line-quantity').value) || 0)); document.querySelectorAll('.service-price').forEach(i => value += parseFloat(i.value) || 0); document.getElementById('edit-order-total').textContent = value.toFixed(2) + ' EUR'; }
function reindex(selector, prefix) { document.querySelectorAll(selector).forEach((row, index) => row.querySelectorAll('input[name], select[name]').forEach(input => input.name = input.name.replace(new RegExp(`${prefix}\\[\\d+\\]`), `${prefix}[${index}]`))); }
function bindPart(row) { row.querySelector('.part-select').addEventListener('change', e => { const p = e.target.options[e.target.selectedIndex].dataset.price; if (p) row.querySelector('.line-price').value = p; total(); }); row.querySelector('.remove-part').addEventListener('click', () => { row.remove(); reindex('.part-row', 'Parts'); total(); }); }
function bindService(row) { row.querySelector('.remove-service').addEventListener('click', () => { row.remove(); reindex('.service-row', 'Services'); total(); }); }
document.querySelectorAll('.part-row').forEach(bindPart); document.querySelectorAll('.service-row').forEach(bindService);
document.getElementById('add-part').addEventListener('click', () => { partsBody.insertAdjacentHTML('beforeend', document.getElementById('part-template').innerHTML.replaceAll('__index__', partIndex++)); bindPart(partsBody.lastElementChild); });
document.getElementById('add-service').addEventListener('click', () => { servicesBody.insertAdjacentHTML('beforeend', document.getElementById('service-template').innerHTML.replaceAll('__index__', serviceIndex++)); bindService(servicesBody.lastElementChild); });

const devices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CustomerDevices.Select(device => new { device.Id, device.CustomerId, device.DeviceType, device.ModelAndSerialNumber, photos = device.Photos.Select(photo => new { photo.Id, photo.FileName, photo.OriginalFileName }) }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
const customerSelect = document.getElementById('edit-customer-select');
const deviceSelect = document.getElementById('edit-device-select');
const newDeviceFields = document.getElementById('edit-new-device-fields');
const photoPicker = document.getElementById('edit-device-photo-picker');
const photoInput = document.getElementById('edit-device-photos');
const photoPreview = document.getElementById('edit-device-photo-preview');
const selectedDeviceId = '@Model.Input.CustomerDeviceId';
let photoFiles = [];
const deletedPhotoIds = new Set();
function syncPhotoFiles() { const data = new DataTransfer(); photoFiles.forEach(file => data.items.add(file)); photoInput.files = data.files; }
function renderPhotos() {
    photoPreview.innerHTML = '';
    const device = devices.find(item => String(item.id) === deviceSelect.value);
    (device?.photos || []).forEach(photo => {
        if (deletedPhotoIds.has(photo.id)) return;
        const item = document.createElement('div'); item.className = 'warehouse-photo-item';
        item.innerHTML = `<a href="/uploads/customer-devices/${photo.fileName}" target="_blank"><img src="/uploads/customer-devices/${photo.fileName}" alt="${photo.originalFileName || 'Device photo'}"></a><button type="button" class="warehouse-photo-delete" data-remove-existing-photo="${photo.id}" title="Remove photo" aria-label="Remove photo">×</button>`;
        photoPreview.appendChild(item);
    });
    photoFiles.forEach((file, index) => {
        const item = document.createElement('div'); item.className = 'warehouse-photo-item';
        item.innerHTML = `<img src="${URL.createObjectURL(file)}" alt="${file.name}"><button type="button" class="warehouse-photo-delete" data-remove-new-photo="${index}" title="Remove photo" aria-label="Remove photo">×</button>`;
        photoPreview.appendChild(item);
    });
}
function loadDevices() {
    deviceSelect.innerHTML = '<option value="">Add new device</option>';
    devices.filter(device => device.customerId === customerSelect.value).forEach(device => deviceSelect.add(new Option(device.deviceType + (device.modelAndSerialNumber ? ' — ' + device.modelAndSerialNumber : ''), device.id)));
    if (devices.some(device => String(device.id) === selectedDeviceId && device.customerId === customerSelect.value)) deviceSelect.value = selectedDeviceId;
    newDeviceFields.hidden = deviceSelect.value !== '';
    renderPhotos();
}
customerSelect.addEventListener('change', loadDevices);
deviceSelect.addEventListener('change', () => { newDeviceFields.hidden = deviceSelect.value !== ''; renderPhotos(); });
photoInput.addEventListener('change', () => { photoFiles = Array.from(photoInput.files); renderPhotos(); });
photoPicker.addEventListener('click', event => {
    const removeNew = event.target.closest('[data-remove-new-photo]');
    if (removeNew) { photoFiles.splice(Number(removeNew.dataset.removeNewPhoto), 1); syncPhotoFiles(); renderPhotos(); return; }
    const removeExisting = event.target.closest('[data-remove-existing-photo]');
    if (removeExisting) { deletedPhotoIds.add(Number(removeExisting.dataset.removeExistingPhoto)); const input = document.createElement('input'); input.type = 'hidden'; input.name = 'Input.DeletedDevicePhotoIds'; input.value = removeExisting.dataset.removeExistingPhoto; photoPicker.appendChild(input); renderPhotos(); }
});
const accessoryOptions = document.getElementById('edit-accessories-options');
const accessoryValue = document.getElementById('edit-accessories-value');
const accessoryOther = document.getElementById('edit-accessories-other');
const accessoryValues = (accessoryValue.value || '').split(',').map(value => value.trim()).filter(Boolean);
const knownAccessories = new Set(['SIM card', 'Case', 'Charger', 'Cable', 'Bag', 'Other']);
const selectedAccessories = new Set(accessoryValues.filter(value => knownAccessories.has(value)));
const customAccessory = accessoryValues.filter(value => !knownAccessories.has(value));
if (customAccessory.length > 0) { selectedAccessories.add('Other'); accessoryOther.value = customAccessory.join(', '); }
accessoryOptions.querySelectorAll('[data-accessory]').forEach(button => { if (selectedAccessories.has(button.dataset.accessory)) button.classList.add('selected'); });
function syncAccessories() { accessoryValue.value = [...accessoryOptions.querySelectorAll('.selected')].map(button => button.dataset.accessory).filter(value => value !== 'Other').concat(accessoryOptions.querySelector('[data-accessory="Other"]').classList.contains('selected') && accessoryOther.value.trim() ? [accessoryOther.value.trim()] : []).join(', '); accessoryOther.hidden = !accessoryOptions.querySelector('[data-accessory="Other"]').classList.contains('selected'); }
accessoryOptions.addEventListener('click', event => { const button = event.target.closest('[data-accessory]'); if (button) { if (button.dataset.accessory === 'Other') button.classList.add('selected'); else button.classList.toggle('selected'); syncAccessories(); } });
accessoryOther.addEventListener('input', syncAccessories);
document.getElementById('edit-order-form').addEventListener('submit', syncAccessories);
loadDevices(); total();
</script>
}
