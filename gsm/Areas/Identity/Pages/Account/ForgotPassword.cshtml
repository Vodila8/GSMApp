@page
@model gsm.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-page">
    <div class="auth-card">
        <h2 class="auth-title">Forgot password?</h2>
        @if (Model.EmailSent)
        {
            <div class="alert alert-success">If an account with that email exists, a password reset link has been sent.</div>
        }
        else
        {
            <p>Enter your email address and we will send you a link to create a new password.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Send reset link</button>
            </form>
        }
        <p class="auth-switch"><a asp-page="./Login">Back to login</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
