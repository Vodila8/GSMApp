@page
@model gsm.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Registration";
}

<div class="auth-page">
    <div class="auth-card">
        <span class="auth-kicker">SERVICE MANAGEMENT</span>
        <h2 class="auth-title">Create your company</h2>
        <p class="auth-subtitle">Register the company owner account to get started.</p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <p class="text-success">@Model.StatusMessage</p>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.CompanyName" class="form-label"></label>
                <input asp-for="Input.CompanyName" class="form-control" autocomplete="organization" placeholder="e.g. FixPoint Service" />
                <span asp-validation-for="Input.CompanyName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.OwnerName" class="form-label"></label>
                <input asp-for="Input.OwnerName" class="form-control" autocomplete="name" placeholder="Your full name" />
                <span asp-validation-for="Input.OwnerName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="you@company.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Create company account</button>
        </form>

        <p class="auth-switch">
            Already have an account? <a asp-page="./Login">Log in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
