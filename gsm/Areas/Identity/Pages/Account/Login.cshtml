@page
@model gsm.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="auth-card">
        <h2 class="auth-title">Login</h2>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Login" class="form-label"></label>
                <input asp-for="Input.Login" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Login" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <div class="mb-3 text-end">
                <a asp-page="./ForgotPassword">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100">Log in</button>
        </form>

        <p class="auth-switch">
            No account? <a asp-page="./Register">Register</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
